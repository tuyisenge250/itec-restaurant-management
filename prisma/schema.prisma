generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

enum Role {
  admin
  kitchen
  waiter
  cashier
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrdersCreated    PurchaseOrder[]        @relation("POCreatedBy")
  purchaseOrdersApproved   PurchaseOrder[]        @relation("POApprovedBy")
  goodsReceipts            GoodsReceipt[]         @relation("ReceivedByUser")
  supplierPaymentsRecorded SupplierPayment[]      @relation("SupplierPaymentRecordedBy")
  inventoryTransactions    InventoryTransaction[] @relation("RecordedByUser")
  prepProductionRuns       PrepProductionRun[]    @relation("PrepRecordedByUser")
  productionOrdersCreated  PrepProductionOrder[]  @relation("ProductionOrderCreatedBy")
  orders                   Order[]                @relation("CreatedByWaiter")
  ordersStarted            Order[]                @relation("OrderStartedBy")
  preparedOrderItems       OrderItem[]            @relation("PreparedByKitchen")
  voidedOrderItems         OrderItem[]            @relation("VoidedByUser")
  payments                 Payment[]              @relation("RecordedByUser")
  expensesRecorded         Expense[]              @relation("ExpenseRecordedBy")
  auditLogs                AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  paymentTerms String? // e.g. "Net 30", "COD"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  inventoryLots  InventoryLot[] // denormalized for fast "price history per supplier per item" queries
  payments       SupplierPayment[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────
// PROCUREMENT (Purchase Order process)
// ─────────────────────────────────────────────

enum PurchaseOrderStatus {
  draft
  pending_approval
  ordered
  partially_received
  received
  cancelled
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(draft)
  createdById     String
  createdBy       User                @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  reorderedFromId String? // "reorder from a previous PO"
  reorderedFrom   PurchaseOrder?      @relation("POReorder", fields: [reorderedFromId], references: [id])
  reorderedInto   PurchaseOrder[]     @relation("POReorder")
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  payments      SupplierPayment[]

  @@map("purchase_orders")
}

// Tracks what's actually been paid to the supplier against a PO — separate
// from GoodsReceipt (which records what arrived and prices the inventory
// lot). "Amount owed" is derived as received value (sum of goods-receipt
// lines, the actual invoiced cost) minus payments, never ordered value —
// you don't owe for what hasn't been delivered yet.
model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String // denormalized for fast "all payments to this supplier" queries
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  amount          Float
  method          PaymentMethod
  notes           String?
  recordedById    String
  recordedBy      User          @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@map("supplier_payments")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityOrdered  Float
  quantityReceived Float         @default(0) // running total, kept in sync with GoodsReceiptLine
  unitCost         Float // cost at time of ordering — becomes the lot's cost on receipt unless overridden

  goodsReceiptLines GoodsReceiptLine[]

  @@map("purchase_order_items")
}

// A receipt event against a PO — supports partial or full goods receipt.
// Each line creates (or adds to) an InventoryLot, tagged with a costing method at receipt time.
model GoodsReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String
  receivedBy      User          @relation("ReceivedByUser", fields: [receivedById], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?

  lines GoodsReceiptLine[]

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived    Float
  unitCost            Float // actual price paid for this batch — may differ from PO's expected unitCost
  costingMethod       CostingMethod // admin tags this batch FIFO or LIFO at receipt time
  inventoryLotId      String            @unique
  inventoryLot        InventoryLot      @relation(fields: [inventoryLotId], references: [id])

  @@map("goods_receipt_lines")
}

// ─────────────────────────────────────────────
// STOCK / INVENTORY (lot-based, no averaged cost)
// ─────────────────────────────────────────────

enum InventoryItemType {
  raw // purchased directly from suppliers
  prepared // intermediate — only ever consumed as an ingredient in another recipe (via PrepRecipeItem), never sold directly
  finished_good // ready to sell/serve as-is — sits in stock waiting for an order, referenced by a MenuItem's RecipeItem (e.g. a cooked batch, a bottled drink)
}

model InventoryItem {
  id           String            @id @default(cuid())
  name         String
  unit         String // "kg", "l", "pcs", etc.
  itemType     InventoryItemType @default(raw)
  currentStock Float             @default(0) // denormalized cache = sum of lot.quantityRemaining, source of truth is lots
  reorderLevel Float             @default(0)
  isActive     Boolean           @default(true) // deactivation is the real "delete" — history is never destroyed
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  purchaseOrderItems    PurchaseOrderItem[]
  lots                  InventoryLot[]
  inventoryTransactions InventoryTransaction[]
  recipeItems           RecipeItem[] // used as an ingredient in a MenuItem BOM

  // Sub-recipe / two-level BOM support:
  prepRecipe       PrepRecipe?      @relation("PrepRecipeOutput") // if itemType = prepared or finished_good, this is how it's made (both are produced via a PrepProductionRun)
  prepRecipeInputs PrepRecipeItem[] // if this item is used as a raw input to *other* prepared/finished_good items

  @@map("inventory_items")
}

enum CostingMethod {
  fifo
  lifo
}

// A single priced batch/lot. Every receipt (purchase or prep production) creates one.
// Costing is never averaged — each lot keeps its own real price.
model InventoryLot {
  id                String        @id @default(cuid())
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  supplierId        String? // null for in-house prepared-item lots
  supplier          Supplier?     @relation(fields: [supplierId], references: [id])
  costingMethod     CostingMethod // determines draw-down priority: LIFO lots drawn before FIFO lots
  unitCost          Float // the actual price paid (or computed prep cost) for this lot
  quantityReceived  Float
  quantityRemaining Float // decremented as this lot is consumed/wasted/adjusted
  receivedAt        DateTime      @default(now())
  expiresAt         DateTime? // meaningful mainly for finished_good lots (a cooked batch held warm/prepped ahead) — null for most raw/prepared lots. Informational only: no automated enforcement, surfaced in the UI, waste logging is the manual remedy when something expires unsold.
  notes             String?

  goodsReceiptLine      GoodsReceiptLine?
  prepProductionRun     PrepProductionRun?     @relation("ProducedLot")
  inventoryTransactions InventoryTransaction[]

  @@index([inventoryItemId, costingMethod, receivedAt])
  @@map("inventory_lots")
}

enum InventoryTransactionType {
  receipt // from purchase order goods receipt, or prep production output
  consumption // deducted on order fulfillment or prep production input
  waste // spoilage / manual write-off — always lot-specific
  adjustment // manual correction, requires a reason code
}

// Source of the transaction, for audit/reporting (COGS per order, waste report, etc.)
enum InventoryTransactionSource {
  purchase_order
  sale
  prep_production
  waste
  manual_adjustment
}

// Immutable ledger — every receipt, consumption, waste, and adjustment, tied to the specific lot affected.
model InventoryTransaction {
  id              String                     @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem              @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  lotId           String
  lot             InventoryLot               @relation(fields: [lotId], references: [id])
  type            InventoryTransactionType
  source          InventoryTransactionSource
  quantity        Float // positive for receipt, negative for consumption/waste/adjustment
  unitCost        Float // cost basis of the lot at time of transaction, for COGS traceability
  referenceId     String? // orderId, orderItemId, purchaseOrderId, prepProductionRunId, etc.
  reasonCode      String? // required for manual adjustments
  recordedById    String
  recordedBy      User                       @relation("RecordedByUser", fields: [recordedById], references: [id])
  notes           String?
  createdAt       DateTime                   @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([lotId])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// SUB-RECIPES / YIELD (raw material → prepared item)
// e.g. 10kg raw potatoes → N portions of prepped chips
// ─────────────────────────────────────────────

model PrepRecipe {
  id             String        @id @default(cuid())
  outputItemId   String        @unique // the prepared InventoryItem this recipe produces
  outputItem     InventoryItem @relation("PrepRecipeOutput", fields: [outputItemId], references: [id])
  yieldQuantity  Float // expected output quantity per production run, in outputItem's unit
  batchInputNote String? // e.g. "based on 10kg raw potatoes"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inputs           PrepRecipeItem[]
  productionRuns   PrepProductionRun[]
  productionOrders PrepProductionOrder[]

  @@map("prep_recipes")
}

model PrepRecipeItem {
  id           String        @id @default(cuid())
  prepRecipeId String
  prepRecipe   PrepRecipe    @relation(fields: [prepRecipeId], references: [id], onDelete: Cascade)
  inputItemId  String // raw or another prepared InventoryItem
  inputItem    InventoryItem @relation(fields: [inputItemId], references: [id])
  quantity     Float // amount of inputItem used per one production run (batch)

  @@unique([prepRecipeId, inputItemId])
  @@map("prep_recipe_items")
}

enum ProductionSource {
  internal // made in-house — ingredients are deducted at fulfillment, scaled to the actual quantity produced
  outside // outsourced to a third party who does the labor — WE still supply the ingredients (deducted the
  // moment the order is placed, scaled to the target quantity, since that's when they physically leave
  // our stock); the lot's final cost is that ingredient cost plus the third party's service fee
}

enum ProductionOrderStatus {
  pending
  fulfilled
  cancelled
}

// A planned production request: admin orders a target quantity of a recipe's
// output and, for an internal order, assigns it to kitchen or waiter — the
// same "who does this" choice a menu item's requiresPreparation makes, just
// for production instead of serving a customer. An internal order sits in
// its assignee's queue until they (or admin) actually run the batch; an
// outside order deducts its ingredients immediately (see ProductionSource)
// and then sits until admin records the third party's delivery. Either way,
// fulfilling it creates the PrepProductionRun that produces the output lot
// — this model is a planning/routing layer on top of that, not a
// replacement for it; an ad-hoc production run (no order) is still fully
// supported.
model PrepProductionOrder {
  id                     String                @id @default(cuid())
  prepRecipeId           String
  prepRecipe             PrepRecipe            @relation(fields: [prepRecipeId], references: [id])
  targetQuantity         Float // drives the ingredient quantities — always scaled from this, never a fixed recipe batch size
  source                 ProductionSource // decided at order creation; the run that fulfills it must match
  // Who this internal order is assigned to execute it — kitchen or waiter. Always null for an outside
  // order (there's no in-house assignee; admin is the one who receives it).
  assignedRole           Role?
  // The ingredient cost already deducted at creation, for an outside order only — locked in then because
  // that's when the ingredients actually left the building. Read back at receiving to compute final unit
  // cost (this + the service fee paid). Always null for an internal order (nothing is deducted until
  // fulfillment, using whatever quantity is actually produced then).
  reservedIngredientCost Float?
  status                 ProductionOrderStatus @default(pending)
  notes                  String?
  createdById            String
  createdBy              User                  @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime              @default(now())

  fulfillment PrepProductionRun? @relation("ProductionOrderFulfillment")

  @@map("prep_production_orders")
}

// A single production event: consumes input lots (per FIFO/LIFO rule) for an internal run, produces one output lot.
model PrepProductionRun {
  id                String               @id @default(cuid())
  prepRecipeId      String
  prepRecipe        PrepRecipe           @relation(fields: [prepRecipeId], references: [id])
  quantityProduced  Float
  source            ProductionSource     @default(internal)
  // Recorded for reference on an internal run, but deliberately NOT folded into the produced lot's
  // unitCost/COGS (see producePrepRecipe) — labor is tracked as a period Expense instead. Folding both in
  // would double-count labor once it's also logged as a "Salaries"-type expense. If/when expense-tracking
  // work touches labor costing, confirm with the team before changing this. Always 0 for an outside run.
  laborCost         Float                @default(0)
  // Total amount paid to the third party for the whole batch — only set when source = outside. Unlike
  // laborCost, this IS folded into the produced lot's unitCost, since it's the only real cost basis: no
  // ingredients of yours were consumed, so there's nothing else to price the lot from.
  outsideCost       Float?
  // Set only when this run fulfills a PrepProductionOrder — null for an ad-hoc run started without one.
  productionOrderId String?              @unique
  productionOrder   PrepProductionOrder? @relation("ProductionOrderFulfillment", fields: [productionOrderId], references: [id])
  producedLotId     String               @unique
  producedLot       InventoryLot         @relation("ProducedLot", fields: [producedLotId], references: [id])
  recordedById      String
  recordedBy        User                 @relation("PrepRecordedByUser", fields: [recordedById], references: [id])
  createdAt         DateTime             @default(now())

  @@map("prep_production_runs")
}

// ─────────────────────────────────────────────
// MENU & RECIPE (bridges Stock → Kitchen)
// ─────────────────────────────────────────────

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  menuItems MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                  String        @id @default(cuid())
  name                String
  categoryId          String?
  category            MenuCategory? @relation(fields: [categoryId], references: [id])
  price               Float
  preparationCost     Float         @default(0) // per-dish prep cost component, separate from raw ingredient cost
  isAvailable         Boolean       @default(true) // auto-disabled by app logic when a required ingredient is out of stock
  requiresPreparation Boolean       @default(true) // false = direct-serve: no kitchen ticket, served immediately by the waiter (e.g. a Coke, bottled water)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  recipeItems RecipeItem[]
  orderItems  OrderItem[]

  @@map("menu_items")
}

// Recipe/BOM: links a menu item to raw ingredients or prepared items + quantities.
// Cost = sum(quantity * actual lot price of inventoryItem) + MenuItem.preparationCost
model RecipeItem {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String // may be raw or prepared (two-level BOM)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Float // amount of inventory item used per one menu item unit

  @@unique([menuItemId, inventoryItemId])
  @@map("recipe_items")
}

// ─────────────────────────────────────────────
// ORDERS (Waiter / Kitchen)
// ─────────────────────────────────────────────

// Order.status is derived from these (see computeOrderStatus in order.service.ts)
// rather than written independently, so the two can never drift apart.
enum OrderStatus {
  pending // waiter can still add/edit/remove items
  preparing // sent to kitchen — item edits locked for waiter; kitchen can still void an item
  ready
  served
  paid
  cancelled
}

enum OrderItemStatus {
  pending
  preparing // kitchen-prepared items only
  ready // kitchen-prepared items only
  served
  voided
}

model Order {
  id          String      @id @default(cuid())
  table       String
  status      OrderStatus @default(pending)
  createdById String
  createdBy   User        @relation("CreatedByWaiter", fields: [createdById], references: [id])

  // Split bill: a split creates new child orders carrying a subset of items
  splitFromId String?
  splitFrom   Order?  @relation("OrderSplit", fields: [splitFromId], references: [id])
  splitInto   Order[] @relation("OrderSplit")

  // Merge: a merged-away order points at the order it was merged into and is cancelled
  mergedIntoId String?
  mergedInto   Order?  @relation("OrderMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Order[] @relation("OrderMerge")

  discountPercent Float? // discount applied pre-payment, subject to role-based limits (app-enforced)
  discountAmount  Float?
  discountReason  String?

  // Set the moment a kitchen user (or admin) claims this order's pending
  // kitchen-bound (requiresPreparation) items off the queue — from then on
  // only that person (or admin) can advance those items further; other
  // kitchen staff can see it but not act on it. Direct-serve items are never
  // part of this claim — they were never the kitchen's to claim.
  startedById String?
  startedBy   User?     @relation("OrderStartedBy", fields: [startedById], references: [id])
  startedAt   DateTime?

  receiptNumber String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  quantity    Int
  priceAtSale Float // menu price snapshot at time of order
  costAtSale  Float // recipe cost snapshot (ingredient cost from actual lots + prep cost) — for per-order COGS

  // Snapshot of MenuItem.requiresPreparation at the time this line was added
  // — the menu can change later without retroactively changing this line.
  requiresPreparation Boolean         @default(true)
  status              OrderItemStatus @default(pending)
  // Set the moment a prep item is claimed off the kitchen queue (see
  // Order.startedById) — always null for direct-serve items, since they
  // never enter the kitchen queue at all.
  sentToKitchenAt     DateTime?

  // Kitchen fulfillment / chef activity tracking (prep items only — set when
  // a prep item is marked ready, i.e. when its stock is actually consumed)
  preparedById String?
  preparedBy   User?     @relation("PreparedByKitchen", fields: [preparedById], references: [id])
  preparedAt   DateTime?

  // Kitchen-side void, allowed only once status has passed `pending`
  isVoided   Boolean   @default(false)
  voidedById String?
  voidedBy   User?     @relation("VoidedByUser", fields: [voidedById], references: [id])
  voidedAt   DateTime?
  voidReason String?

  @@map("order_items")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

enum PaymentMethod {
  cash
  card
  momo
  other
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  method       PaymentMethod
  amount       Float
  discount     Float         @default(0) // discount applied at payment time
  recordedById String
  recordedBy   User          @relation("RecordedByUser", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())

  @@map("payments")
}

// ─────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────

// Snapshot stored at end-of-day close-out; most other reports (revenue, COGS,
// profit by item/day, waste cost) are computed on demand from the models above.
model DailyCloseOut {
  id             String   @id @default(cuid())
  businessDate   DateTime @unique @db.Date
  totalRevenue   Float
  totalCOGS      Float
  totalWasteCost Float
  cashTotal      Float
  cardTotal      Float
  momoTotal      Float
  otherTotal     Float
  createdAt      DateTime @default(now())

  @@map("daily_close_outs")
}

// Admin-managed, not a hardcoded enum — same pattern as MenuCategory.
model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id           String          @id @default(cuid())
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount       Float
  expenseDate  DateTime        @db.Date // the period this expense belongs to — reporting always
  // queries this, never createdAt (when it was entered)
  description  String?
  isRecurring  Boolean         @default(false) // a label only — no automation re-creates it each period
  recordedById String
  recordedBy   User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  // Soft-deleted, not hard-deleted: a report run "as of last month" must stay
  // reproducible even if someone later deletes an old expense.
  isDeleted    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([expenseDate])
  @@index([categoryId, expenseDate])
  @@map("expenses")
}

// ─────────────────────────────────────────────
// CROSS-CUTTING
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "purchase_order.approved", "order_item.voided"
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
